# AppStore - Database Configuration
# Copy to .env and adjust values as needed
# NEVER commit .env with real passwords!

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT_FROM=5433
DB_PORT_TO=5432
DB_NAME=appstore
DB_ADMIN=postgres
DB_ADMIN_PASS=changeme_secure_password

# Docker (reference only - docker-compose.yml uses pinned image)
DOCKER_IMAGE=postgres
DOCKER_TAG=16-alpine
DB_VOLUME=appstore_pgdata:/var/lib/postgresql/data

# Application
APP_ENV=Development
DEFAULT_LANGUAGE=ru
DEFAULT_THEME=Light