<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Project</AssemblyName>
    <RootNamespace>Project</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <StartupObject>Project.ApplicationApp</StartupObject>
    <ApplicationIcon>Resources\Icons\app.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Views\**\*.cs" />
    <Compile Include="ViewModels\**\*.cs" />
    <Compile Include="Converters\**\*.cs" />
    <Compile Include="Commands\**\*.cs" />
    <Compile Include="Configuration\CompositionRoot.cs" />
    <Compile Include="Services\ThemeService.cs" />
    <Compile Include="Services\LocalizationService.cs" />
    <Compile Include="ApplicationApp.xaml.cs" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppStore.Core\AppStore.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AppStore.Core">
      <HintPath>..\AppStore.Core\bin\$(Configuration)\net8.0\AppStore.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\app.ico" />
    <Resource Include="Resources\Cursors\arrow.cur" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Resources\Buffer\apps.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Resources\Buffer\users.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update=".env" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>