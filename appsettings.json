{
  "Database": {
    "Host": "localhost",
    "Port": 5433,
    "Name": "appstore",
    "User": "postgres",
    "Password": ""
  },
  "Application": {
    "Environment": "Development",
    "Language": "ru",
    "Theme": "Light"
  },
  "Security": {
    "PasswordHashAlgorithm": "BCrypt"
  },
  "Ui": {
    "DefaultPageSize": 6,
    "MaxPriceFilter": 1000
  },
  "Docker": {
    "Image": "postgres",
    "Tag": "16-alpine",
    "Volume": "appstore_pgdata:/var/lib/postgresql/data"
  }
}
