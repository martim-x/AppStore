<Window
  x:Class="Project.Views.LoginWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="{DynamicResource AppTitle}"
  Background="{DynamicResource WindowBgBrush}"
  FontFamily="Segoe UI"
  Width="380"
  SizeToContent="Height"
  WindowStartupLocation="CenterScreen"
  ResizeMode="CanResize"
>
  <Border CornerRadius="16" Background="{DynamicResource WindowBgBrush}">
    <Border.Effect>
      <DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.18" Color="#000000" />
    </Border.Effect>
    <StackPanel Margin="32,32,32,28">
      <!-- Logo -->
      <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
        <Border
          Width="56"
          Height="56"
          CornerRadius="14"
          HorizontalAlignment="Center"
          Margin="0,0,0,12"
        >
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#0072F7" Offset="0" />
              <GradientStop Color="#34AADC" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock
            Text="A"
            FontSize="28"
            FontWeight="Bold"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
          />
        </Border>
        <TextBlock
          Text="App Store"
          FontSize="20"
          FontWeight="Bold"
          Foreground="{DynamicResource TitleTextBrush}"
          HorizontalAlignment="Center"
        />
        <TextBlock
          x:Name="SubtitleText"
          Text="{DynamicResource LoginSubtitle}"
          FontSize="13"
          Foreground="{DynamicResource SecondaryTextBrush}"
          HorizontalAlignment="Center"
          Margin="0,4,0,0"
        />
      </StackPanel>
      <!-- Error message -->
      <Border
        x:Name="ErrorBorder"
        Background="#FFF0F0"
        CornerRadius="8"
        Padding="12,8"
        Margin="0,0,0,14"
        Visibility="Collapsed"
      >
        <TextBlock
          x:Name="ErrorText"
          FontSize="13"
          Foreground="{DynamicResource ErrorBrush}"
          TextWrapping="Wrap"
        />
      </Border>
      <!-- Login field -->
      <TextBlock
        Text="{DynamicResource LoginLabel}"
        Style="{DynamicResource CaptionStyle}"
        Margin="0,0,0,4"
      />
      <Border
        x:Name="LoginFieldBorder"
        Background="{DynamicResource InfoCardBgBrush}"
        CornerRadius="10"
        BorderThickness="1.5"
        BorderBrush="{DynamicResource DividerBrush}"
        Height="36"
        Margin="0,0,0,14"
      >
        <TextBox
          x:Name="LoginBox"
          Background="Transparent"
          BorderThickness="0"
          FontSize="14"
          Foreground="{DynamicResource TitleTextBrush}"
          Padding="8,4"
          CaretBrush="{DynamicResource AccentBlueBrush}"
          GotFocus="OnFieldFocus"
          LostFocus="OnFieldBlur"
          KeyDown="OnKeyDown"
        >
          <TextBox.Template>
            <ControlTemplate TargetType="TextBox">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
            </ControlTemplate>
          </TextBox.Template>
        </TextBox>
      </Border>
      <!-- Password field -->
      <TextBlock
        Text="{DynamicResource PasswordLabel}"
        Style="{DynamicResource CaptionStyle}"
        Margin="0,0,0,4"
      />
      <Border
        x:Name="PassFieldBorder"
        Background="{DynamicResource InfoCardBgBrush}"
        CornerRadius="10"
        BorderThickness="1.5"
        BorderBrush="{DynamicResource DividerBrush}"
        Height="36"
        Margin="0,0,0,14"
      >
        <PasswordBox
          x:Name="PassBox"
          Background="Transparent"
          BorderThickness="0"
          FontSize="14"
          Foreground="{DynamicResource TitleTextBrush}"
          Padding="8,4"
          CaretBrush="{DynamicResource AccentBlueBrush}"
          GotFocus="OnFieldFocus"
          LostFocus="OnFieldBlur"
          KeyDown="OnKeyDown"
        >
          <PasswordBox.Template>
            <ControlTemplate TargetType="PasswordBox">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
            </ControlTemplate>
          </PasswordBox.Template>
        </PasswordBox>
      </Border>
      <!-- Confirm password (только режим регистрации) -->
      <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
        <TextBlock
          Text="{DynamicResource ConfirmPasswordLabel}"
          Style="{DynamicResource CaptionStyle}"
          Margin="0,0,0,4"
        />
        <Border
          x:Name="ConfirmFieldBorder"
          Background="{DynamicResource InfoCardBgBrush}"
          CornerRadius="10"
          BorderThickness="1.5"
          BorderBrush="{DynamicResource DividerBrush}"
          Height="36"
          Margin="0,0,0,14"
        >
          <PasswordBox
            x:Name="ConfirmBox"
            Background="Transparent"
            BorderThickness="0"
            FontSize="14"
            Foreground="{DynamicResource TitleTextBrush}"
            Padding="8,4"
            CaretBrush="{DynamicResource AccentBlueBrush}"
            GotFocus="OnFieldFocus"
            LostFocus="OnFieldBlur"
            KeyDown="OnKeyDown"
          >
            <PasswordBox.Template>
              <ControlTemplate TargetType="PasswordBox">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
              </ControlTemplate>
            </PasswordBox.Template>
          </PasswordBox>
        </Border>
      </StackPanel>
      <!-- Sign in button -->
      <Button
        x:Name="SignInBtn"
        Click="OnSignIn"
        IsDefault="True"
        Height="44"
        FontSize="15"
        FontWeight="SemiBold"
        Background="{DynamicResource AccentBlueBrush}"
        Foreground="White"
        BorderThickness="0"
        Cursor="Hand"
      >
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border
              Background="{TemplateBinding Background}"
              CornerRadius="10"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.75" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <TextBlock x:Name="SubmitText" Text="{DynamicResource SignIn}" />
      </Button>
      <!-- Переключение режима вход ↔ регистрация -->
      <Button
        x:Name="ToggleModeButton"
        Click="OnToggleMode"
        Margin="0,12,0,0"
        HorizontalAlignment="Center"
        Background="Transparent"
        BorderThickness="0"
        Cursor="Hand"
      >
        <TextBlock
          x:Name="ToggleModeText"
          Text="{DynamicResource NoAccount}"
          FontSize="12"
          Foreground="{DynamicResource AccentBlueBrush}"
        />
      </Button>
    </StackPanel>
  </Border>
</Window>
