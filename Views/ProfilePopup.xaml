<Window
  x:Class="Project.Views.ProfilePopup"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  FontFamily="Segoe UI"
  Width="300"
  SizeToContent="Height"
  ResizeMode="CanResize"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  Deactivated="OnDeactivated"
>
  <!--
        ProfilePopup.xaml — Updated version
        ─ Avatar + name + role badge
        ─ Separator
        ─ Editable profile fields (FirstName, LastName, Email) + Save button
        ─ Separator
        ─ Change Password section (OldPw, NewPw) + Change button
        ─ Separator
        ─ Dark Mode toggle row
        ─ Separator
        ─ Logout button

        All colors via DynamicResource so light/dark theme switch works at runtime.
    -->
  <Border CornerRadius="14" Background="{DynamicResource PopupBgBrush}" BorderThickness="0">
    <Border.Effect>
      <DropShadowEffect ShadowDepth="0" BlurRadius="28" Opacity="0.22" Color="#000000" />
    </Border.Effect>
    <StackPanel>
      <!-- ═══ Заголовок «Профиль» ═══════════════════════════ -->
      <TextBlock
        Text="{DynamicResource ProfileEditTitle}"
        FontSize="14"
        FontWeight="SemiBold"
        Foreground="{DynamicResource TitleTextBrush}"
        Margin="20,16,20,10"
      />
      <!-- ═══ Шапка: аватар + имя + статус ══════════════════ -->
      <Grid Margin="20,0,20,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border
          x:Name="AvatarBorder"
          Grid.Column="0"
          Width="56"
          Height="56"
          CornerRadius="28"
        >
          <TextBlock
            x:Name="AvatarLetter"
            FontSize="22"
            FontWeight="Bold"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
          />
        </Border>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock
            x:Name="LoginText"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TitleTextBrush}"
          />
          <Border
            x:Name="RoleBadge"
            CornerRadius="10"
            Padding="10,4"
            HorizontalAlignment="Left"
            Margin="0,10,0,0"
          >
            <TextBlock x:Name="RoleText" FontSize="12" FontWeight="SemiBold" Foreground="White" />
          </Border>
        </StackPanel>
      </Grid>
      <!-- ── Separator ─────────────────────────────────────── -->
      <Border Height="1" Background="{DynamicResource SeparatorBrush}" />
      <!-- ═══ Поля профиля (Имя, Фамилия, Эл. почта) ════════ -->
      <StackPanel Margin="20,10,20,10">
        <!-- First Name -->
        <TextBlock
          Text="{DynamicResource LabelFirstName}"
          FontSize="12"
          Foreground="{DynamicResource SecondaryTextBrush}"
          Margin="0,0,0,10"
        />
        <TextBox
          Style="{DynamicResource FormTextBoxStyle}"
          BorderBrush="{DynamicResource DividerBrush}"
          Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
          Tag="{DynamicResource PlaceholderFirstName}"
          Margin="0,0,0,10"
          Height="36"
        />
        <!-- Last Name -->
        <TextBlock
          Text="{DynamicResource LabelLastName}"
          FontSize="12"
          Foreground="{DynamicResource SecondaryTextBrush}"
          Margin="0,0,0,10"
        />
        <TextBox
          Style="{DynamicResource FormTextBoxStyle}"
          BorderBrush="{DynamicResource DividerBrush}"
          Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
          Tag="{DynamicResource PlaceholderLastName}"
          Margin="0,0,0,10"
          Height="36"
        />
        <!-- Email -->
        <TextBlock
          Text="{DynamicResource LabelEmail}"
          FontSize="12"
          Foreground="{DynamicResource SecondaryTextBrush}"
          Margin="0,0,0,10"
        />
        <TextBox
          Style="{DynamicResource FormTextBoxStyle}"
          BorderBrush="{DynamicResource DividerBrush}"
          Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
          Tag="{DynamicResource PlaceholderEmail}"
          Margin="0,0,0,10"
          Height="36"
        />
        <!-- Save Profile button -->
        <Button
          Style="{DynamicResource PrimaryButtonStyle}"
          HorizontalAlignment="Stretch"
          Command="{Binding SaveProfileCommand}"
        >
          <TextBlock Text="{DynamicResource SaveProfile}" FontSize="13" />
        </Button>
      </StackPanel>
      <!-- ── Separator ─────────────────────────────────────── -->
      <Border Height="1" Background="{DynamicResource SeparatorBrush}" />
      <!-- ═══ Change Password Section ════════════════════════ -->
      <StackPanel Margin="20,10,20,10">
        <TextBlock
          Text="{DynamicResource ChangePasswordTitle}"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TitleTextBrush}"
          Margin="0,0,0,10"
        />
        <!-- Old Password -->
        <TextBlock
          Text="{DynamicResource LabelOldPassword}"
          FontSize="12"
          Foreground="{DynamicResource SecondaryTextBrush}"
          Margin="0,0,0,10"
        />
        <Border
          x:Name="OldPwBorder"
          Background="{DynamicResource InfoCardBgBrush}"
          CornerRadius="10"
          BorderThickness="1.5"
          BorderBrush="{DynamicResource DividerBrush}"
          Margin="0,0,0,10"
          Height="36"
        >
          <PasswordBox
            x:Name="OldPasswordBox"
            Background="Transparent"
            BorderThickness="0"
            FontSize="14"
            Foreground="{DynamicResource TitleTextBrush}"
            CaretBrush="{DynamicResource AccentBlueBrush}"
            Padding="8,4"
            GotFocus="OnPasswordBoxGotFocus"
            LostFocus="OnPasswordBoxLostFocus"
          >
            <PasswordBox.Template>
              <ControlTemplate TargetType="PasswordBox">
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
              </ControlTemplate>
            </PasswordBox.Template>
          </PasswordBox>
        </Border>
        <!-- New Password -->
        <TextBlock
          Text="{DynamicResource LabelNewPassword}"
          FontSize="12"
          Foreground="{DynamicResource SecondaryTextBrush}"
          Margin="0,0,0,10"
        />
        <Border
          x:Name="NewPwBorder"
          Background="{DynamicResource InfoCardBgBrush}"
          CornerRadius="10"
          BorderThickness="1.5"
          BorderBrush="{DynamicResource DividerBrush}"
          Margin="0,0,0,10"
          Height="36"
        >
          <PasswordBox
            x:Name="NewPasswordBox"
            Background="Transparent"
            BorderThickness="0"
            FontSize="14"
            Foreground="{DynamicResource TitleTextBrush}"
            CaretBrush="{DynamicResource AccentBlueBrush}"
            Padding="8,4"
            GotFocus="OnPasswordBoxGotFocus"
            LostFocus="OnPasswordBoxLostFocus"
          >
            <PasswordBox.Template>
              <ControlTemplate TargetType="PasswordBox">
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
              </ControlTemplate>
            </PasswordBox.Template>
          </PasswordBox>
        </Border>
        <!-- Change Password button -->
        <Button
          Style="{DynamicResource GetButtonStyle}"
          HorizontalAlignment="Stretch"
          Command="{Binding ChangePasswordCommand}"
        >
          <TextBlock
            Text="{DynamicResource ChangePassword}"
            Foreground="{DynamicResource GetBtnTextBrush}"
            FontSize="13"
            FontWeight="SemiBold"
          />
        </Button>
      </StackPanel>
      <!-- ── Separator ─────────────────────────────────────── -->
      <Border Height="1" Background="{DynamicResource SeparatorBrush}" />
      <!-- ═══ Database Health Check: убран по решению автора (15.11.2026) ═══ -->
      <!-- ═══ Language Row (APP-001: настройки отдельно от навигации) ═══ -->
      <Grid Margin="20,10,20,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock
            Text="{DynamicResource LanguageLabel}"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TitleTextBrush}"
          />
          <TextBlock
            Text="{DynamicResource LanguageHint}"
            FontSize="11"
            Foreground="{DynamicResource SecondaryTextBrush}"
            Margin="0,4,0,0"
          />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button
            Content="RU"
            Tag="ru"
            Click="OnLanguageClick"
            Style="{DynamicResource GetButtonStyle}"
            Padding="12,0"
            FontSize="12"
            Margin="0,0,10,0"
          />
          <Button
            Content="EN"
            Tag="en"
            Click="OnLanguageClick"
            Style="{DynamicResource GetButtonStyle}"
            Padding="12,0"
            FontSize="12"
          />
        </StackPanel>
      </Grid>
      <!-- ── Separator ─────────────────────────────────────── -->
      <Border Height="1" Background="{DynamicResource SeparatorBrush}" />
      <!-- ═══ Dark Mode Toggle Row ════════════════════════════ -->
      <Grid Margin="20,10,20,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock
            Text="{DynamicResource DarkModeLabel}"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TitleTextBrush}"
          />
          <TextBlock
            Text="{DynamicResource DarkModeHint}"
            FontSize="11"
            Foreground="{DynamicResource SecondaryTextBrush}"
            Margin="0,4,0,0"
          />
        </StackPanel>
        <ToggleButton
          Grid.Column="1"
          Style="{DynamicResource ToggleSwitchStyle}"
          IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
          VerticalAlignment="Center"
          Command="{Binding ToggleThemeCommand}"
        />
      </Grid>
      <!-- ── Separator ─────────────────────────────────────── -->
      <Border Height="1" Background="{DynamicResource SeparatorBrush}" />
      <!-- ═══ Logout ══════════════════════════════════════════ -->
      <Button
        Click="OnLogout"
        Background="Transparent"
        BorderThickness="0"
        Cursor="Hand"
        Padding="20,10"
        HorizontalContentAlignment="Left"
      >
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="LogoutBd"
              Background="{TemplateBinding Background}"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="LogoutBd" Property="Background" Value="#1AFF3B30" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="LogoutBd" Property="Background" Value="#33FF3B30" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <StackPanel Orientation="Horizontal">
          <TextBlock
            Text="→"
            FontSize="15"
            Foreground="{DynamicResource ErrorBrush}"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
          />
          <TextBlock
            Text="{DynamicResource Logout}"
            FontSize="14"
            Foreground="{DynamicResource ErrorBrush}"
            VerticalAlignment="Center"
          />
        </StackPanel>
      </Button>
      <Border Height="10" />
    </StackPanel>
  </Border>
</Window>
